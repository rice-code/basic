{
  "name": "rice/basic",
  "description": "basic tool",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "php",
    "tools",
    "basic",
    "Clean code"
  ],
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-bcmath": "*",
    "guzzlehttp/guzzle": "^6.0 || ^7.0",
    "nesbot/carbon": "^2.53.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "php-coveralls/php-coveralls": "^2.5",
    "squizlabs/php_codesniffer": "^3.7",
    "vimeo/psalm": "^4.0",
    "phpstan/phpstan": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Rice\\Basic\\": "src/"
    },
    "files": [
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "files": [
      "tests/common.php"
    ]
  },
  "authors": [
    {
      "name": "dengmf",
      "email": "1015814408@qq.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": [
      "phpunit"
    ],
    "test-coverage": [
      "phpunit --coverage-html coverage"
    ],
    "lint": [
      "phpcs --standard=PSR12 --runtime-set ignore_warnings_on_exit 1 src/ tests/"
    ],
    "lint-fix": [
      "phpcbf --standard=PSR12 src/ tests/"
    ],
    "psalm": [
      "psalm --no-cache"
    ],
    "phpstan": [
      "phpstan analyze src/ tests/"
    ],
    "check": [
      "@psalm",
      "@phpstan",
      "@test"
    ],
    "check-all": [
      "@lint",
      "@psalm",
      "@phpstan",
      "@test"
    ]
  }
}
